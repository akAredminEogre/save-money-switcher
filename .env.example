# save-money-switcher ローカル試遊の環境変数サンプル（実値は .env へ・.env はコミットしない）。
# いずれも未設定でローカル試遊は成立する（サーバは既定値で起動する）。

# 待受ポート（既定 3000）。
PORT=3000

# 参加用 QR/リンクの公開基底 URL。空なら 127.0.0.1:PORT へフォールバックする
# （同一 PC 複数タブの試遊は空で足りる。スマホ実機参加は README のネットワーク手順を参照）。
PUBLIC_BASE_URL=

# 同時接続タブレット上限（未設定なら既定値）。
# MAX_TABLET_CONNECTIONS=8

# 永続データ置き場（アカウント等）。未設定なら CWD 直下の ./data。
# 本番（Lightsail）はデプロイで消えぬ絶対パスを与える。
# DATA_DIR=/var/lib/save-money-switcher

# 初期管理者の投入（案A・2026-08-28 殿裁可）。**実値は .env に書かず、起動時にだけ env へ渡すこと。**
# 例: ADMIN_LOGIN_ID="$(op read 'op://<vault>/<item>/username')" \
#     ADMIN_INITIAL_PASSWORD="$(op read 'op://<vault>/<item>/password')" npm run start
# 投入は冪等（既存アカウントのパスワードは上書きしない）。
# ADMIN_LOGIN_ID=
# ADMIN_INITIAL_PASSWORD=
# ADMIN_DISPLAY_NAME=

# 家族限定アクセス制御方式。案A では authenticated（ログイン必須）で確定。
# JOIN_ACCESS_MODE=authenticated
