# save-money-switcher ローカル試遊の環境変数サンプル（実値は .env へ・.env はコミットしない）。
# いずれも未設定でローカル試遊は成立する（サーバは既定値で起動する）。

# 待受ポート（既定 3000）。
PORT=3000

# 参加用 QR/リンクの公開基底 URL。空なら 127.0.0.1:PORT へフォールバックする
# （同一 PC 複数タブの試遊は空で足りる。スマホ実機参加は README のネットワーク手順を参照）。
PUBLIC_BASE_URL=

# 同時接続タブレット上限（未設定なら既定値）。
# MAX_TABLET_CONNECTIONS=8
